# Usuario unico de la app (no hay registro ni tabla de usuarios).
APP_USUARIO=

# Hash bcrypt de la contrasena. NUNCA la contrasena en claro.
# Generar con: python -m app.auth hash   (ejecutado dentro de backend/)
#
# IMPORTANTE si usas Docker Compose: un hash bcrypt trae simbolos "$"
# (ej. $2b$12$....). Docker Compose interpola "$" en los archivos .env, y
# se COME lo que sigue creyendo que es una variable. Escapa cada "$" como
# "$$" aqui, o el login fallara sin ningun error visible. Ejemplo:
#   $2b$12$IfbPVGgYfbHqGZ64h5a9me...   ->   $$2b$$12$$IfbPVGgYfbHqGZ64h5a9me...
# (Si corres el backend sin Docker con `export`, NO lo escapes: pega el
# hash tal cual lo imprimio `python -m app.auth hash`.)
APP_PASSWORD_HASH=

# Secreto para firmar el JWT de sesion. Si falta, el servidor no arranca.
# Generar uno con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
